{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@assets": [
        "src/assets"
      ],
      "@components": [
        "src/components"
      ],
      "@content":[
        "src/content"
      ]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}