---
import { Image } from "astro:assets";
import Overlay from "../../layouts/Overlay.astro";
import { getCollection, type CollectionEntry } from "astro:content";

// This generates all possible paths for the dynamic route
export async function getStaticPaths() {
  const microblogs = await getCollection("microblogs");
  return microblogs.map((microblog) => ({
    params: { slug: microblog.slug },
    props: { microblog },
  }));
}

interface Props {
  microblog: CollectionEntry<"microblogs">;
}

export const prerender = true
const { microblog } = Astro.props;
const { Content } = await microblog.render();
---

<Overlay title={microblog.data.title}>
  <main class="common-container text-theme-text relative">
    <section
      class="flex flex-col gap-10
        desktop:pt-20 desktop:pb-44
        smalldesktop:py-20
        tablet:pt-10 tablet:pb-24
        mobile:pt-10 mobile:pb-24"
    >
      <Image
        src={microblog.data.cover.src}
        alt={microblog.data.cover.alt}
        width={2000}
        height={1000}
        fit="cover"
      />

      <div
        class="desktop:flex desktop:flex-col desktop:gap-20
         smalldesktop:flex smalldesktop:flex-col smalldesktop:gap-20
         tablet:flex tablet:flex-col tablet:gap-10
         mobile:flex mobile:flex-col mobile:gap-10"
      >
        <article
          class="desktop:w-full
          smalldesktop:w-full
          tablet:w-full
          mobile:w-full"
        >
          <div class="flex flex-col gap-4">
            <p class="text-body1 font-DM font-bold">
              {microblog.data.category}
            </p>
            <h1 class="text-title2 font-playfair">{microblog.data.title}</h1>
            <p class="text-body1 font-DM">
              {microblog.data.author} / {microblog.data.date}
            </p>
          </div>
          <div class="divider my-10"></div>
          <div id="body" class="max-w-none">
            <Content />
          </div>
        </article>
      </div>
    </section>
  </main>
</Overlay>

<style>
  :global(#body p) {
    font-family: "DM Sans", serif;
    font-size: 18px;
    line-height: 26px;
    text-align: justify;
    margin: 1rem 0;
  }

  :global(#body h2) {
    font-family: "DM Sans", serif;
    font-size: 36px;
    line-height: 48px;
    margin: 2rem 0 1rem;
    font-weight: 600;
  }

  :global(#body h3) {
    font-family: "DM Sans", serif;
    font-size: 24px;
    line-height: 32px;
    margin: 1.5rem 0 0.75rem;
    font-weight: 600;
  }

  :global(#body li) {
    font-family: "DM Sans", serif;
    font-size: 18px;
    line-height: 28px;
    margin-bottom: 0.75rem;
  }
</style>
