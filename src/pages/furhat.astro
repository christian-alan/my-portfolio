---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import Cover from "../assets/furhat/Cover.jpg";
import Setup from "../assets/furhat/EXSetup.jpg";
import Footer from "../components/Footer.astro";
import Problem from "../assets/furhat/Problems.jpg";
import BlogSection from "../components/blog/BlogSection.astro";
import Dashboard from "../assets/furhat/Dashboard.jpg";
import Actions from "../assets/furhat/Actions.jpg";
import Camera from "../assets/furhat/Camera.jpg";
import Reader from "../assets/furhat/Reader.jpg";
import Inclusive from "../assets/furhat/Inclusive.jpg";
import Collaboration from "../assets/furhat/Collaboration.jpg";
import Wireframe from "../assets/furhat/Wireframe.jpg";
---

<Layout title="Alan Christian">
  <main class="common-container" class="bg-light-green relative">
    <!-- Hero section -->

    <section
      class="
      desktop:pt-80 desktop:flex desktop:items-center  desktop:flex-row
      smalldesktop:pt-80 smalldesktop:flex smalldesktop:items-center smalldesktop:flex-row
      tablet:pt-60 tablet:flex table:flex-col tablet:items-center 
      mobile:pt-60 mobile:flex mobile:flex-col mobile:items-center
      "
    >
      <!-- Header -->
      <div class="flex gap-4 flex-col blog-container">
        <h2
          class="text-dark desktop:text-left smalldesktop:text-left mobile:text-center tablet:text-center font-bold"
        >
          Teleoperator's workbench
        </h2>
        <h4 class="font-bold italic">
          <span class="humana-gradient text-dark/0 bg-clip-text"
            >Speculative design
          </span>
        </h4>
        <p class="opacity-80 text-dark">
          Cowrite’s writing platform, lets you craft resumes, job applications,
          job ads and LinkedIn summary in minutes. The process is simple and
          precise, boosting our customers' writing efficiency by an impressive
          45%.
        </p>
      </div>

      <div class="divider-light my-16"></div>
      <!-- Project meta data -->
      <div class=" 
        desktop:grid-cols-3 desktop:grid desktop:gap-5 desktop:text-dark desktop:blog-container
        smalldesktop:grid-cols-3 smalldesktop:grid smalldesktop:gap-5 smalldesktop:text-dark smalldesktop:blog-container
        tablet:flex tablet:flex-col tablet:justify-center tablet:items-center tablet:gap-10 tablet:text-dark tablet:blog-container
        mobile:flex mobile:flex-col mobile:justify-center mobile:items-center mobile:gap-10 mobile:text-dark mobile:blog-container
      ">
        <div class="
        desktop:flex desktop:flex-col desktop:items-start
        smalldesktop:flex smalldesktop:flex-col smalldesktop:items-start
        tablet:flex tablet:flex-col tablet:justify-center tablet:items-center
        mobile:flex mobile:flex-col mobile:justify-center mobile:items-center
      ">
          <h4 class="font-bold mb-4">Roles & responsibilities</h4>
          <p class="text-left">UX Research</p>
          <p class="text-left">UX Design</p>
        </div>
        <div
        class="
        desktop:flex desktop:flex-col desktop:items-start
        smalldesktop:flex smalldesktop:flex-col smalldesktop:items-start
        tablet:flex tablet:flex-col tablet:justify-center tablet:items-center
        mobile:flex mobile:flex-col mobile:justify-center mobile:items-center
      ">
          <h4 class="font-bold text-center mb-4">Project context</h4>
          <p class="text-center">Spring 2023</p>
          <p class="text-center">Coursework: Advanced Interaction Design</p>
        </div>
        <div
        class="
        desktop:flex desktop:flex-col desktop:items-start
        smalldesktop:flex smalldesktop:flex-col smalldesktop:items-start
        tablet:flex tablet:flex-col tablet:justify-center tablet:items-center
        mobile:flex mobile:flex-col mobile:justify-center mobile:items-center
      ">
          <h4 class="font-bold text-right mb-4">Tools used</h4>
          <p class="text-right">Figma</p>
          <p class="text-right">Furhat Robot</p>
          <p class="text-right">Furhat SDK</p>
        </div>
      </div>

      <div class="divider-light my-16"></div>
      <!-- Hero image -->
      <Image
        src={Cover}
        class="cowrite-shadow rounded-xl mt-10"
        alt="Furhat's Hero"
      />
    </section>
    <div class="divider-light my-16"></div>

    <!-- Section jumps -->
    <div class="sticky top-20 -inset-20 z-10 flex">
      <ul class="flex absolute -left-52 text-sm flex-col gap-2 text-dark">
        <li class="font-bold leading-10 tracking-widest">TABLE OF CONTENTS</li>
        <li><a href="#overview">Overview</a></li>
        <li><a href="#usecase">Usecase</a></li>
        <li><a href="#problem">Problem</a></li>
        <li><a href="#design-methodology">Design Methodology</a></li>
        <li><a href="#wireframes">Wireframes</a></li>
        <li><a href="#prototype">Prototype</a></li>
        <li style="margin-left:10px">
          <a href="#dashboard">Dashboard</a>
        </li>
        <li style="margin-left:10px">
          <a href="#collaboration">Collaboration script </a>
        </li>
        <li style="margin-left:10px">
          <a href="#camera">Camera adjuster</a>
        </li>
        <li style="margin-left:10px">
          <a href="#inclusive">Inclusive actions</a>
        </li>
        <li style="margin-left:10px">
          <a href="#reader">Dialog reader</a>
        </li>
        <li style="margin-left:10px">
          <a href="#actions">System actions</a>
        </li>
      </ul>
    </div>

    <!-- Overview section -->
    <section id="overview" class="flex flex-col">
      <BlogSection
        title="Overview"
        description=`This is an iteration of the work that me and my colleague Hong Wang did for our thesis. The dashboard that I present in this assignment is an iteration of the dashboard used by a teleoperator for the teleoperation of the robot, which is primarily Hong Wang’s side of the project. The robot used in this context is the Furhat Robot and for our thesis, we aimed to build a robot group facilitator.`
      />
    </section>
    <!-- Usecase section -->
    <section id="usecase" class="flex flex-col gap-4 mt-16">
      <BlogSection
        title="Use case"
        description=`For our thesis, we aimed to develop a social robot that enables a group of three university students to have an inclusively collaborative group experience during their group work. We approached this problem from two methods of developing the robot systems: a) a fully autonomous system; and b) a teleoperated system (robot operated by a human user)
        This document contains the design proposal for a dashboard that the teleoperator of the robot could use to control the robot. This dashboard is intended to be used on the web browser and it is compatible with laptops (preferably 14, 15, 16 inches), tablets, and desktops.
      `
      />

      <!-- <BlogSection
      subtitle="Constraint"
      description=`For this use-case, the teleoperator operates the robot from a different room.`
      /> -->

      <BlogSection
        subtitle="Role of the teleoperator"
        description=`In the given use-case, the teleoperator’s job is to foster inclusion and collaboration in the group, eventually leading the group to a collaborative group experience for the participants.`
        images={[Setup]}
      />
    </section>

    <!-- Problems section -->
    <section id="problem" class="flex flex-col mt-16">
      <BlogSection
        title="Problem"
        images={[Problem]}
      />
    </section>

    <!-- Design methodology section -->
    <section id="design-methodology" class="flex flex-col">
      <BlogSection
        title="Design methodology"
        description=`Fave is one of Southeast Asia's fintech startup that helps consumers
        save, while empowering small and medium-sized enterprises to grow in
        the digital economy. Fave's key offering includes cashless payments,
        online/offline deals and other offers. Fave has been acquired by
        PineLabs, an India-based unicorn on April 2021. In this project, we
        revamped the user experience and redesigned the UI, which is one of
        the largest projects at Fave since 2019.`
      />
    </section>

    <div class="divider-light my-16"></div>

    <!-- Wireframes section -->
    <section id="wireframes" class="flex flex-col">
      <BlogSection
        title="Wireframes"
        images={[Wireframe]}
      />
    </section>

    <!-- Prototype Section  -->
    <section id="prototype" class="flex flex-col">
      <BlogSection title="Prototype" />
    </section>
    <!-- Prototype: Dashboard  -->
    <section id="dashboard" class="flex flex-col mt-5">
      <BlogSection images={[Dashboard]} />
    </section>

    <!-- Prototype: Collaboration  -->
    <section id="collaboration" class="flex flex-col">
      <BlogSection
        subtitle="Collaboration script component"
        description=`The purpose of the first component is to provide a structure to the discussion. This concept has been adopted from the field of educational psychology. Article [1], describes collaboration scripts in detail. This component has 4 states. These states essentially represent the 4 phases that the group typically goes through. The 4 states/phases are: 1) Coordination; 2) Information pooling; 3) Discussion; and 4) Decision making.`
        bullets={[
          'The 4 phases of discussion are listed on the top panel of the component. The light-red bar at the bottom is the visual representation of time for the teleoperator.',
          'This component primarily informs the teleoperator on the primary goal of the phase that the teleoperator could help the group achieve.',
          '“Your actions” lists the plausible actions within the respective phase for the group.  The “Used:n” is to indicate to the teleoperator the amount of times, the teleoperator used that particular action.',
          'Time left denotes the time in a textual format.'
        ]}
        images={[Collaboration]}
      />
    </section>

    <!-- Prototype: Camera  -->
    <section id="camera" class="flex flex-col">
      <BlogSection  
      subtitle="Camera adjuster component" 
      description="This function lets the tele-operator have the “group’s view” through the camera of the Furhat robot. This component is inspired by the proprietary dashboard of the Furhat Robot. The primary function of this component is to let the teleoperator access the group from the first-person point of view and make direct prompts in the form of speech by entering text in the text bar given below." 
      images={[Camera]} 
      bullets={['Provides real-time video feed of the group', 'Digital camera angle rotator', 'Textbox to make speech prompts']}
      />
    </section>

    <!-- Prototype: Inclusion  -->
    <section id="inclusive" class="flex flex-col">
      <BlogSection
        subtitle="Inclusive actions component"
        images={[Inclusive]}
        description="These actions are designed to allow the teleoperator to foster inclusion in the group. The system provides 6 essential actions needed to foster inclusion within the group. These actions are intended to foster a positive and vibrant mood for participants within the group."
      />
    </section>

    <!-- Prototype: reader  -->
    <section id="Reader" class="flex flex-col">
      <BlogSection 
      subtitle="Dialogue reader component" 
      bullets={[
        'The overall dialog bubble sub-component',
        'Timestamp of the dialog',
        'Dialog bubble for Furhat’s interventions'
      ]}
      description="The dashboard generates the transcription of real-time conversations taking place within the group. This component allows the teleoperator to have access to the conversation in the written format in addition to the audio format. " 
      images={[Reader]} />
    </section>

    <!-- Prototype: System action  -->
    <section id="actions" class="flex flex-col">
      <BlogSection 
        description="This dashboard provides 3 essential system actions: a) Language settings; b) Sound intensity (to control the loudness of the audio); and c) System shutdown. "  
        subtitle="System actions components" 
        images={[Actions]} 
        bullets={[
          'Provides language options',
          'Volume control to regulate the audio intensity',
          'System shut-down option to terminate the dashboard'
        ]}
        />
    </section>

    <div class="divider-light my-16"></div>

    <!-- More to explore -->
    <!-- <section class="flex flex-col"> -->
      <!-- Header -->
      <!-- <div class="flex flex-row items-center gap-5">
        <h3 class="font-bold text-dark">More to explore</h3>
        <div class="h-0.5 w-32 bg-dark"></div>
      </div> -->

      <!-- Explore more -->
