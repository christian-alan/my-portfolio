        <img
          id="cowrite"
          class="col-span-2 img-blob"
          src="https://images.unsplash.com/photo-1693768420662-a07a2bcaee20?q=80&w=2848&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
          alt="Blog Placeholder"
        />
        <img
          id="furhat"
          class="col-span-1 img-blob"
          src="https://images.unsplash.com/photo-1720188228786-e6cb3b668aef?q=80&w=3732&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
          alt="Blog Placeholder"
        />
      </div>
    </section>

    <div class="divider-light my-16"></div> -->

    <!-- Footer -->
    <Footer />
  </main>
</Layout>
<style>
  div ul {
    list-style-type: none;
  }
  div ul li {
    display: inline;
    font-weight: 500;
  }
  div ul li a.active {
    font-weight: bold;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const sections = document.querySelectorAll("section");
    const links = document.querySelectorAll("ul li a");
    const options = {
      root: null,
      rootMargin: "0px",
      threshold: 0.5,
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const links = document.querySelector(
          `ul li a[href="#${entry.target.id}"]`
        );

        if (entry.isIntersecting) {
          links.classList.add("active");
        } else {
          links.classList.remove("active");
        }
      }, options);
    });

    sections.forEach((section) => {
      observer.observe(section);
    });
  });
</script>
