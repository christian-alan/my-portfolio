---
import Layout from "@/layouts/Layout.astro";
import Footer from "@/components/Footer.astro";
import { Image } from "astro:assets";
import Experience from "@/components/about/Experience.astro";
import SRM from "@/assets/about/SRM.jpg";
import UU from "@/assets/about/Uppsala.jpg";
import Cowrite from "@/assets/about/Cowrite.png";
import Deloite from "@/assets/about/Deloitte.png";
import Lokaalt from "@/assets/about/Lokaalt.png";
import Surboard from "@/assets/about/Surfboard.png";
import Skills from "@/components/about/Skills.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import AlanChristian from "@/assets/about/AlHeadshot.jpg";

import { list } from "@vercel/blob";

import figma from "@/assets/about/Figma.png";
import react from "@/assets/about/React.png";
import vue from "@/assets/about/Vue.png";
import astro from "@/assets/about/Astro.png";
import firebase from "@/assets/about/Firebase.png";

const navigationItems = [
  { slug: "overview", text: "Overview" },
  { slug: "education", text: "Education" },
  { slug: "research", text: "Research experience" },
  { slug: "work", text: "Work experience" },
  { slug: "skills", text: "Skills" },
  { slug: "languages", text: "Languages" },
];

const options = {
  token: import.meta.env.BLOB_READ_WRITE_TOKEN,
};
const response = await list(options);
const downloadableURL = response.blobs[0].downloadUrl;
---

<Layout title="Alan Christian | About">
  <main class="common-container noise-bg text-theme-text">
    <div
      class="desktop:pt-60 desktop:pb-44 desktop:grid desktop:grid-cols-2 desktop:gap-20
      smalldesktop:pt-60 smalldesktop:pb-44 smalldesktop:grid smalldesktop:grid-cols-2 smalldesktop:gap-20
      tablet:pt-52 tablet:pb-24 tablet:grid tablet:grid-cols-3 tablet:gap-10
      mobile:pt-52 mobile:pb-24 mobile:flex mobile:flex-col-reverse mobile:gap-10"
    >
      <!-- Left column with sections -->
      <div
        class="desktop:col-span-1 smalldesktop:col-span-1 tablet:col-span-2 flex flex-col gap-5"
      >
        <!-- Overview section -->
        <section id="overview" class="flex flex-col gap-4">
          <div class="flex flex-col gap-4">
            <h1
              class="desktop:text-title1 smalldesktop:text-title1 tablet:text-title2 mobile:text-title2 font-playfair"
            >
              Hey! Alan here
            </h1>
            <p
              class="desktop:text-title3 smalldesktop:text-title3 tablet:text-subtitle1 mobile:text-subtitle1 font-playfair text-left"
            >
              I'm a designer, researcher and an okayish coder
            </p>
          </div>
          <div class="divider my-8"></div>
          <div class="flex flex-col gap-4">
            <h3
              class="desktop:text-subtitle1 smalldesktop:text-subtitle1 tablet:text-subtitle1 mobile:text-subtitle1 font-DM font-bold"
            >
              My relation to design
            </h3>
            <p class="text-body font-DM text-justify opacity-70">
              I work at the intersection of design, research, and development.
              To be precise, I focus on interface design, user studies,
              usability analysis, and application development, primarily focused
              on web and mobile interfaces. It is challenging to be juggling
              these three disciplines at once, but the nature of innovation and
              innovative products requires an interdisciplinary approach.
              Therefore, I see the need to nurture an interdisciplinary
              approach.
            </p>
            <p class="text-body font-DM text-justify opacity-70">
              My software engineering philosophy is fairly summarized by what
              Maggie Appleton said about modern software engineering. She said
              that software design and development aren't two different
              disciplines. They are the same discipline grotesquely chopped into
              two halves, leaving us with poorly designed, buggy, and inelegant
              software. Good software is tailored to users' needs and wants.
              Therefore, good software requires a thorough understanding of its
              users and their goals. Disciplines such as social sciences and
              cognitive sciences that focus on the humanistic side of the
              equation play a crucial role.
            </p>
            <p class="text-body font-DM text-justify opacity-70">
              In terms of education, I have a Bachelor's in Computer Science and
              Engineering, followed by a Master's in Human-Computer Interaction.
              My skill set lies in interface design, performing user studies,
              and frontend engineering. Check out my projects to better
              understand my skill set.
            </p>
          </div>

          <div class="flex flex-col gap-4">
            <h3
              class="desktop:text-subtitle1 smalldesktop:text-subtitle1 tablet:text-subtitle1 mobile:text-subtitle1 font-DM font-bold"
            >
              A slice of my professional history
            </h3>
            <p class="text-body font-DM text-justify opacity-70">
              I started my career by working for a startup during my bachelor's
              degree. I completed my Bachelor's in Computer Science and
              Engineering at SRM Institute of Science and Technology. I joined a
              startup called WisOpt as an Android developer but later realized
              that my interest lies within UX and design. Following that role, I
              joined 2adpro, now a subsidiary of Deloitte Digital, as a Graphic
              Designer, as I thought that visual design is possibly the most
              important aspect of UX design.
            </p>
            <p class="text-body font-DM text-justify opacity-70">
              After that, I got an interesting opportunity to make an impact at
              a fairly young startup called Surfboard Payments, where I honed
              the role of a design engineer. This role shaped my skill set and
              deepened my understanding of startups and software design and
              development in general.
            </p>
            <p class="text-body font-DM text-justify opacity-70">
              In 2022, I decided to pursue my master's education at Uppsala
              University. I graduated in September 2024, not just with a
              Master's degree in Human-Computer Interaction (HCI), but with a
              broadened understanding of the term "user experience" and all the
              nuances it encompasses.
            </p>
            <p class="text-body font-DM text-justify opacity-70">
              Prior to my master's, my skill set was limited to frontend
              development using the latest JavaScript frameworks. However, my
              master's equipped me with research methods and methodologies
              focusing on performing user studies and usability studies.
            </p>
          </div>

          <div class="flex flex-col gap-4">
            <h3
              class="desktop:text-subtitle1 smalldesktop:text-subtitle1 tablet:text-subtitle1 mobile:text-subtitle1 font-DM font-bold"
            >
              What is this website?
            </h3>
            <p class="text-body font-DM text-justify opacity-70">
              This website is not just my portfolio, but a repository of ideas
              and opinions. I believe in authenticity, and I believe that
              authenticity ultimately wins. Through this website, I aim to
              portray the authentic me, not just a collection of projects.
              Although I am proud of my projects, I am more than just my
              projects. My aim with this website is to create a digital
              embodiment of myself, Alan Christian—a little space of my own, my
              own little digital garden.
            </p>
          </div>
        </section>

        <div class="divider my-8"></div>

        <!-- Education section -->
        <section id="education" class="flex flex-col gap-10">
          <h1
            class="desktop:text-title3 smalldesktop:text-title3 tablet:text-title4 mobile:text-title4 font-DM font-bold"
          >
            Education
          </h1>
          <Experience
            title="Master in Human-Computer Interaction"
            subtitle="Uppsala University"
            thesis="Can Social Robots foster inclusive collaboration?"
            image={UU}
            location="Uppsala, SV"
            dates="2022 - 2024"
          />
          <Experience
            title="Bachelor of Technology in Computer Science and Engineering"
            subtitle="SRM Institute of Science and Technology"
            thesis="Electric Vehicle fleet management and charging demand handling solution for fleet managers"
            image={SRM}
            location="Chennai, IN"
            dates="2015 - 2019"
          />
        </section>

        <div class="divider my-8"></div>

        <!-- Research section -->
        <section id="research" class="flex flex-col gap-10">
          <h1
            class="desktop:text-title3 smalldesktop:text-title3 tablet:text-title4 mobile:text-title4 font-DM font-bold"
          >
            Research experience
          </h1>
          <Experience
            title="Masters thesis student"
            subtitle="Uppsala Social Robotics Lab"
            image={UU}
            location="Uppsala, SV"
            dates="2024"
          />
        </section>

        <div class="divider my-8"></div>

        <!-- Work Experience section -->
        <section id="work" class="flex flex-col gap-10">
          <h1
            class="desktop:text-title3 smalldesktop:text-title3 tablet:text-title4 mobile:text-title4 font-DM font-bold"
          >
            Work experience
          </h1>
          <Experience
            title="UX Engineer"
            subtitle="Lokaalt AB"
            image={Lokaalt}
            location="Stockholm, SV"
            dates="2024"
          />
          <Experience
            title="Design Engineer"
            subtitle="Surfboard Payments AB"
            image={Surboard}
            location="Stockholm, SV"
            dates="2020 - 2023"
          />
          <Experience
            title="UX Consultant"
            subtitle="Cowrite AB"
            image={Cowrite}
            location="Remote"
            dates="2021 - 2023"
          />
          <Experience
            title="Graphic Designer"
            subtitle="2adpro (now a part of Deloitte Digital)"
            image={Deloite}
            location="Chennai, IN"
            dates="2019"
          />
        </section>

        <div class="divider my-8"></div>

        <!-- Skills section -->
        <section id="skills" class="flex flex-col gap-10">
          <h1
            class="desktop:text-title3 smalldesktop:text-title3 tablet:text-title4 mobile:text-title4 font-DM font-bold"
          >
            Skills
          </h1>
          <div class="flex flex-col gap-4">
            <p class="text-title4 font-DM font-bold">
              UX Research Methodologies
            </p>
            <div
              class="grid desktop:grid-cols-4 smalldesktop:grid-cols-4 tablet:grid-cols-4 mobile:grid-cols-2 gap-4"
            >
              <Skills title="Surveys" />
              <Skills title="Qualitative Interviews" />
              <Skills title="Statistical Analysis" />
              <Skills title="Contextual Inquiry" />
            </div>
          </div>

          <div class="flex flex-col gap-4">
            <p class="text-title4 font-DM font-bold">Programming Languages</p>
            <div
              class="grid desktop:grid-cols-4 smalldesktop:grid-cols-4 tablet:grid-cols-4 mobile:grid-cols-2 gap-4"
            >
              <Skills title="Typescript" />
              <Skills title="Javascript" />
              <Skills title="Python" />
              <Skills title="Kotlin" />
            </div>
          </div>

          <div class="flex flex-col gap-4">
            <p class="text-title4 font-DM font-bold">Frameworks</p>
            <div
              class="grid desktop:grid-cols-4 smalldesktop:grid-cols-4 tablet:grid-cols-4 mobile:grid-cols-2 gap-4"
            >
              <Skills classes="w-40 h-32" image={astro} title="Astro" />
              <Skills classes="w-40 h-32" image={vue} title="Vue" />
              <Skills classes="w-40 h-32" image={react} title="React" />
              <Skills classes="w-40 h-32" image={firebase} title="GCP" />
              <Skills classes="w-40 h-32" image={figma} title="Figma" />
            </div>
          </div>
        </section>

        <div class="divider my-8"></div>

        <!-- Languages section -->
        <section id="languages" class="flex flex-col gap-10">
          <h1
            class="desktop:text-title3 smalldesktop:text-title3 tablet:text-title4 mobile:text-title4 font-DM font-bold"
          >
            Languages
          </h1>
          <div
            class="grid desktop:grid-cols-4 smalldesktop:grid-cols-4 tablet:grid-cols-4 mobile:grid-cols-4 gap-4"
          >
            <Skills title="English" />
            <Skills title="Hindi" />
            <Skills title="Gujarati" />
            <Skills title="Swedish" />
          </div>
        </section>
      </div>

      <!-- Right column with sticky content -->
      <div
        class="desktop:col-span-1 smalldesktop:col-span-1 tablet:col-span-1 mobile:col-span-1 relative"
      >
        <div
          class="sticky top-28 flex flex-col gap-5"
          style="height: fit-content;"
        >
          <Image src={AlanChristian} alt="Profile image" />

          <div class="flex flex-col gap-4">
            <div id="download-cv" class="flex flex-row gap-4">
              <a class="w-full bg-teal hover:scale-105 transition-all duration-300 text-light text-center text-body2 font-DM p-4 dark:bg-gray"
                href={downloadableURL}
              >
                Download my full CV
              <a/>

            </div>
          </div>

          <div
            class="desktop:block smalldesktop:block tablet:block mobile:hidden"
          >
            <TableOfContents items={navigationItems} />
          </div>
        </div>
      </div>
    </div>
    <div class="divider my-16"></div>
  <Footer />
  </main>
  
</Layout>

<style>
  div ul {
    list-style-type: none;
  }
  div ul li {
    display: inline;
    text-align: end;
  }

  div ul li a.active {
    font-weight: bold;
  }
</style>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const sections = document.querySelectorAll("section");
    const links = document.querySelectorAll("ul li a");
    const options = {
      root: null,
      rootMargin: "0px",
      threshold: 0.5,
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const links = document.querySelector(
          `ul li a[href="#${entry.target.id}"]`,
        );

        if (entry.isIntersecting) {
          links.classList.add("active");
        } else {
          links.classList.remove("active");
        }
      }, options);
    });

    sections.forEach((section) => {
      observer.observe(section);
    });
  });
</script>
