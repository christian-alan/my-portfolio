        mobile:flex mobile:flex-col mobile:justify-center mobile:pt-40 mobile:pb-20 mobile:gap-6"
    >
      <div
        class="roe-gif
          desktop:w-1/4 desktop:absolute desktop:top-64 desktop:right-0 desktop:h-96
          smalldesktop:absolute smalldesktop:right-0 smalldesktop:top-32 smalldesktop:w-1/4 smalldesktop:h-96
          tablet:w-full tablet:h-96 tablet:mx-auto
          mobile:w-full mobile:h-72 mobile:mx-auto"
