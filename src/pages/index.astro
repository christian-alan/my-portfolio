---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import Card from "../components/Card.astro";
import { Image } from "astro:assets";
import DesirableSVG from "../assets/icons/Desirable.svg";
import FunctionalSVG from "../assets/icons/Functional.svg";
import HumanizedSVG from "../assets/icons/Humanized.svg";
import SelfExplainatorySVG from "../assets/icons/SelfExplainatory.svg";
import CowriteCover from "../assets/cowrite/Index.jpg";
import FurhatCover from "../assets/furhat/Index.jpg"; 
import DropDownCover from '../assets/dropdown/Cover.jpg';
import SpotifyCover from '../assets/spotify/Cover.jpg';
---

<Layout title="Alan Christian">
  <main class="common-container" class="bg-light">
    <!-- Hero section -->
    <section
      class="desktop:pt-80 desktop:pb-50 desktop:flex-row desktop:items-center desktop:relative
        smalldesktop:py-44 smalldesktop:items-center smalldesktop:flex-row smalldesktop:relative
        tablet:pt-52 tablet:pb-24 table:flex-col tablet:items-center tablet:justify-center tablet:relative
        mobile:pt-52 mobile:pb-24 mobile:flex-col mobile:items-center mobile:justify-center mobile:relative"
    >
      <div class="desktop:w-full tablet:w-full mobile:w-full">
        <h1
          class="text-dark desktop:text-left smalldesktop:text-left mobile:text-center tablet:text-center"
        >
          Designing technology <br
            class="mobile:hidden tablet:hidden desktop:block smalldesktop:block"
          />
          to feel more <span class="humana-gradient text-dark/0 bg-clip-text"
            >human.</span
          >
        </h1>
        <p
          class="text-dark text-2xl  opacity-70 mt-10 desktop:text-left smalldesktop:text-left mobile:text-center tablet:text-center"
        >
          Hej, I’m Alan. I am a 
		  	<span id="role-italic" class="relative font-playfair italic">
				UI/UX designer & a frontend developer
			</span>
          <br
            class="mobile:hidden tablet:hidden desktop:block smalldesktop:block"
          /> that designs & builds delightful interfaces to drive business success.
		</p>
      </div>
      <div
        class="
        boe-gif 
        desktop:w-1/4 desktop:absolute desktop:top-64 desktop:right-0 desktop:h-96 
        smalldesktop:absolute smalldesktop:right-0 smalldesktop:top-32 smalldesktop:w-1/4 smalldesktop:h-96
        tablet:w-4/5 tablet:h-96 tablet:mx-auto
        mobile:w-4/5 mobile:h-96 mobile:mx-auto
        "
      >
      </div>
    </section>

    <div class="divider-light"></div>

    <!-- My design principles  -->
    <section
      class="desktop:py-48 relative desktop:flex-col desktop:flex
      smalldesktop:py-44 smalldesktop:flex  smalldesktop:flex-col
      tablet:py-32 tablet:flex tablet:flex-col 
      mobile:pt-16 mobile:pb-32 mobile:flex mobile:flex-col
      "
    >
      <!-- Header -->
      <div class="
      desktop:flex desktop:flex-row desktop:items-center desktop:gap-5 desktop:justify-start
      smalldesktop:flex smalldesktop:flex-row smalldesktop:items-center smalldesktop:gap-5 smalldesktop:justify-start
      tablet:flex tablet:flex-col tablet:items-center tablet:justify-center tablet:gap-5
      mobile:flex mobile:flex-col mobile:items-center mobile:justify-center mobile:gap-5
      ">
        <h3 class="font-bold text-dark">My design principles</h3>
        <div class="h-0.5 w-32 bg-dark"></div>
      </div>

      <p class="text-dark text-xl mt-4 opacity-80">
        After spending 4 years working in the industry doing a Masters in HCI, I
        have learned to keep the user human at the centre of it all. Some
        qualities that I see are crucial to good design experiences:
      </p>

      <!-- Principles -->
      <div class="desktop:mt-20 desktop:flex desktop:flex-row desktop:gap-10 desktop:items-start
        smalldesktop:mt-20 smalldesktop:flex smalldesktop:flex-row smalldesktop:gap-10 smalldesktop:items-start
        tablet:mt-20 tablet:flex tablet:flex-col tablet:gap-10 tablet:items-center
        mobile:mt-20 mobile:flex mobile:flex-col mobile:gap-10 mobile:items-center

      ">
        <!-- Principle one -->
        <div class="
          desktop:w-1/4 desktop:flex desktop:flex-col desktop:items-start desktop:justify-start
          smalldesktop:w-1/4 smalldesktop:flex smalldesktop:flex-col smalldesktop:items-start smalldesktop:justify-start
          tablet:w-full tablet:flex tablet:flex-col tablet:items-center tablet:justify-center
          mobile:w-full mobile:flex mobile:flex-col mobile:items-center mobile:justify-center
          ">
          <div class="principle-box">
            <Image src={FunctionalSVG} alt="Functional" />
          </div>
          <h4 class="font-bold text-dark mt-6">Functional</h4>
          <p class="text-dark text-xl mt-4 opacity-80
           desktop:text-left smalldesktop:text-left tablet:text-center mobile:text-center">
            Simple yet efficient and doing what it’s supposed to do.
          </p>
        </div>

        <!-- Principle two -->
        <div class="
          desktop:w-1/4 desktop:flex desktop:flex-col desktop:items-start desktop:justify-start
          smalldesktop:w-1/4 smalldesktop:flex smalldesktop:flex-col smalldesktop:items-start smalldesktop:justify-start
          tablet:w-full tablet:flex tablet:flex-col tablet:items-center tablet:justify-center
          mobile:w-full mobile:flex mobile:flex-col mobile:items-center mobile:justify-center
          ">
          <div class="principle-box">
            <Image src={SelfExplainatorySVG} alt="Functional" />
          </div>
          <h4 class="font-bold text-dark mt-6">Self explanatory</h4>
          <p class="text-dark text-xl mt-4 opacity-80
           desktop:text-left smalldesktop:text-left tablet:text-center mobile:text-center">
            A product should teach its users how to use it.
          </p>
        </div>

        <!-- Principle three -->
        <div class="
          desktop:w-1/4 desktop:flex desktop:flex-col desktop:items-start desktop:justify-start
          smalldesktop:w-1/4 smalldesktop:flex smalldesktop:flex-col smalldesktop:items-start smalldesktop:justify-start
          tablet:w-full tablet:flex tablet:flex-col tablet:items-center tablet:justify-center
          mobile:w-full mobile:flex mobile:flex-col mobile:items-center mobile:justify-center
        ">
          <div class="principle-box">
            <Image src={DesirableSVG} alt="Functional" />
          </div>
          <h4 class="font-bold text-dark mt-6">Desirable</h4>
          <p class="text-dark text-xl mt-4 opacity-80
           desktop:text-left smalldesktop:text-left tablet:text-center mobile:text-center">
            Keeping it simple and playful. Focus on the things that bring
            delight to user. Something that keep them coming back.
          </p>
        </div>

        <!-- Principle four -->
        <div class="
          desktop:w-1/4 desktop:flex desktop:flex-col desktop:items-start desktop:justify-start
          smalldesktop:w-1/4 smalldesktop:flex smalldesktop:flex-col smalldesktop:items-start smalldesktop:justify-start
          tablet:w-full tablet:flex tablet:flex-col tablet:items-center tablet:justify-center
          mobile:w-full mobile:flex mobile:flex-col mobile:items-center mobile:justify-center
        ">
          <div class="principle-box">
            <Image src={HumanizedSVG} alt="Functional" />
          </div>
          <h4 class="font-bold text-dark mt-6">Humanized experience</h4>
          <p class="
          text-dark text-xl mt-4 opacity-80
          desktop:text-left smalldesktop:text-left tablet:text-center mobile:text-center">
            “To err is human, to forgive, divine.” Designing experiences with
            humans is mind.
          </p>
        </div>
      </div>
    </section>

    <!-- Featured projects  -->
    <section>
      <!-- Header -->
      <div class="   
      desktop:flex desktop:flex-row desktop:items-center desktop:gap-5 desktop:justify-start
      smalldesktop:flex smalldesktop:flex-row smalldesktop:items-center smalldesktop:gap-5 smalldesktop:justify-start
      tablet:flex tablet:flex-col tablet:items-center tablet:justify-center tablet:gap-5
      mobile:flex mobile:flex-col mobile:items-center mobile:justify-center mobile:gap-5">
        <h3 class="font-bold text-dark">Featured UX projects 📏 ✏️</h3>
        <div class="h-0.5 w-32 bg-dark"></div>
      </div>

      <!-- Projects -->
      <div class="desktop:grid desktop:grid-cols-3 desktop:gap-10 desktop:mt-10
      smalldesktop:grid smalldesktop:grid-cols-3 smalldesktop:gap-10 smalldesktop:mt-10
      tablet:flex tablet:flex-col tablet:gap-10 tablet:mt-10
      mobile:flex mobile:flex-col mobile:gap-10 mobile:mt-10
      
      ">
        <Image
          id="cowrite"
          class=`desktop:col-span-2 desktop:img-blob desktop:cursor-pointer
          smalldesktop:col-span-2 smalldesktop:img-blob smalldesktop:cursor-pointer
          tablet:w-full tablet:img-blob tablet:cursor-pointer
          mobile:w-full mobile:img-blob mobile:cursor-pointer
          `
          src={CowriteCover}
          alt="cowrite's placeholder"
          style="transition-duration:0.4s"
        />
        <Image
          id="furhat"
          class=`desktop:col-span-1 desktop:img-blob desktop:cursor-pointer
          smalldesktop:col-span-1 smalldesktop:img-blob smalldesktop:cursor-pointer
          tablet:w-full tablet:img-blob tablet:cursor-pointer
          mobile:w-full mobile:img-blob mobile:cursor-pointer
          `
          src={FurhatCover}
          alt="furhat's placeholder"
          style="transition-duration:0.2s"
        />
      </div>
    </section>

     <!-- Featured Frontend projects  -->
     <section class="desktop:py-16 relative smalldesktop:py-16 tablet:py-16 mobile:py-12">
      <!-- Header -->
      <div class="   
      desktop:flex desktop:flex-row desktop:items-center desktop:gap-5 desktop:justify-start
      smalldesktop:flex smalldesktop:flex-row smalldesktop:items-center smalldesktop:gap-5 smalldesktop:justify-start
      tablet:flex tablet:flex-col tablet:items-center tablet:justify-center tablet:gap-5
      mobile:flex mobile:flex-col mobile:items-center mobile:justify-center mobile:gap-5">
        <h3 class="font-bold text-dark">Featured dev projects 🦄</h3>
        <div class="h-0.5 w-32 bg-dark"></div>
      </div>

      <!-- Projects -->
      <div class="desktop:grid desktop:grid-cols-2 desktop:gap-10 desktop:mt-10
      smalldesktop:grid smalldesktop:grid-cols-2 smalldesktop:gap-10 smalldesktop:mt-10
      tablet:flex tablet:flex-col tablet:gap-10 tablet:mt-10
      mobile:flex mobile:flex-col mobile:gap-10 mobile:mt-10
      
      ">
      <div  class="col-span-1 flex flex-col img-dev-card items-center gap-5 bg-white">
        <Image
          id="drop-down"
          class=`desktop:col-span-1 desktop:img-dev-blob desktop:cursor-pointer
          smalldesktop:col-span-1 smalldesktop:img-dev-blob smalldesktop:cursor-pointer
          tablet:w-full tablet:img-dev-blob tablet:cursor-pointer
          mobile:w-full mobile:img-dev-blob mobile:cursor-pointer
          `
          src={DropDownCover}
          alt="Drop Down placeholder"
          style="transition-duration:0.4s"
        />
        <div class="flex flex-col items-center gap-2"> 
          <h4 class="text-sm text-dark"> BY ALAN CHRISTIAN</h4>
          <p class="text-center text-dark desktop:text-lg smalldesktop:text-lg tablet:text-lg mobile:text-sm font-bold"> A roadmap to building a reusable drop-down component in <br/>  Astro & Vue</p>
        </div>

      </div>
      <!-- <div class="col-span-1 flex flex-col img-dev-card items-center gap-5 bg-white">
        <Image
          id="drop-down"
          class=`desktop:col-span-1 desktop:img-dev-blob desktop:cursor-pointer
          smalldesktop:col-span-1 smalldesktop:img-dev-blob smalldesktop:cursor-pointer
          tablet:w-full tablet:img-dev-blob tablet:cursor-pointer
          mobile:w-full mobile:img-dev-blob mobile:cursor-pointer
          `
          src={SpotifyCover}
          alt="spotify placeholder"
          style="transition-duration:0.4s"
        />
        <div class="flex flex-col items-center gap-2">
          <h4 class="text-sm text-dark"> BY ALAN CHRISTIAN</h4>
          <p class="text-center text-dark font-bold desktop:text-lg smalldesktop:text-lg tablet:text-lg mobile:text-sm "> A knock off of spotify in Astro & Vue</p>
        </div> 
      </div> -->
      
      </div>
    </section>

    <div class="divider-light my-16"></div>

    <!-- Footer -->
    <Footer />
  </main>
</Layout>
<script>

  const cowriteBlog = document.getElementById("cowrite");
  const componentBlog = document.getElementById("drop-down");
  const furhatBlog = document.getElementById("furhat");

  cowriteBlog.addEventListener("click", () => {
    window.location.href = "/cowrite/";
  });
  componentBlog.addEventListener("click", () => {
    window.location.href = "/dropdown/";
  });

  furhatBlog.addEventListener("click", () => {
    window.location.href = "/furhat/";
  });

  // image card animation script
  cowriteBlog.addEventListener("mousemove",(event)=>{
    cowriteBlog.style.transform = `perspective(400px) rotateX(${event.layerX/1000}deg) rotateY(${event.layerY/1000}deg)`
  })
  cowriteBlog.addEventListener("mouseleave",()=>{
     cowriteBlog.style.transform = `perspective(400px) rotateX(0deg) rotateY(0deg)`
  })

  furhatBlog.addEventListener("mousemove",(event)=>{
    furhatBlog.style.transform = `perspective(100px) rotateX(${event.layerX/1000}deg) rotateY(${event.layerY/1000}deg)`
  })
  furhatBlog.addEventListener("mouseleave",()=>{
     furhatBlog.style.transform = `perspective(100px) rotateX(0deg) rotateY(0deg)`
  })



</script>

<style>

	#role-italic:before{
		display: block;
		position: absolute;
		content:'';
		top: 100%;
    width: 100%;
    left: 0;
    height: 3px;
		border-radius: 3px;
		background: var(--humana);
	}


</style>
