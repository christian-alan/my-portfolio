---
import Layout from "@/layouts/Layout.astro";
import Footer from "@/components/Footer.astro";
import CowriteCover from "@/assets/cowrite/Index.jpg";
import FurhatCover from "@/assets/furhat/Index.jpg";
import DropDownCover from "@/content/projects/DropDownCover.jpg";
import CowriteIcon from "@/assets/cowrite/Icon.svg";
import FurhatIcon from "@/assets/furhat/Icon.svg";
import Microblog from "@/components/Microblogs.astro";
import DummyOne from "@/content/microblogs/DesignHeuristics.png";
import DummyTwo from "@/content/microblogs/Interfaces.png";
import DummyThree from "@/content/microblogs/Interaction.png";
import Project from "@/components/Project.astro";
import CHIACover from "@/assets/chia/Chia.png";
import CHIAIcon from "@/assets/chia/chiaIcon.svg";
import { Meteors } from "@/components/magicui/meteors";
import DropDownIcon from "@/assets/dropdown/Icon.svg";
---

<Layout title="Alan Christian | Home">
  <main class="common-container noise-bg">
    <!-- Hero section -->
    <section
      class="mobile:pt-52 mobile:pb-0 mobile:flex mobile:flex-col mobile:items-center mobile:justify-center mobile:relative mobile:gap-20
      tablet:pt-52 tablet:pb-0 tablet:flex-col tablet:items-center tablet:justify-center tablet:relative tablet:gap-20
      smalldesktop:pt-72 smalldesktop:pb-60 smalldesktop:justify-between smalldesktop:flex-row smalldesktop:relative smalldesktop:gap-10 smalldesktop:items-center
      desktop:pt-60 desktop:pb-44 desktop:flex-row desktop:justify-between desktop:relative desktop:gap-10 desktop:items-center"
    >
      <div
        class="w-full
        desktop:w-3/5
        smalldesktop:w-3/5
        tablet:w-full
        mobile:w-full"
      >
        <p
          class="text-theme-text text-subtitle1
        mobile:text-center
        tablet:text-center
        smalldesktop:text-left
        desktop:text-left"
        >
          Design Engineer
        </p>
        <h1
          class="text-theme-text font-playfair
          mobile:text-center mobile:text-title2
          tablet:text-center tablet:text-title2
          smalldesktop:text-left smalldesktop:text-title2
          desktop:text-left desktop:text-title1"
        >
          Hey, I'm Alan Christian! <br />I design and develop software
        </h1>
      </div>

      <div
        class="flex flex-col
        mobile:w-4/5 mobile:h-96 mobile:mx-auto mobile:items-center mobile:gap-2
        tablet:w-4/5 tablet:h-96 tablet:mx-auto tablet:items-center tablet:gap-2
        smalldesktop:w-2/5 smalldesktop:absolute smalldesktop:right-0 smalldesktop:top-64 smalldesktop:items-end
        desktop:w-2/5 desktop:absolute desktop:top-48 desktop:right-0 desktop:items-end"
      >
        <div
          class="bg-orange dark:bg-orange-dark rounded-full
        desktop:w-72
        tablet:w-64
        smalldesktop:w-68
        mobile:w-48"
        >
          <div
            style="transform: rotateY(180deg)"
            class="boe-gif
            mobile:h-48
            tablet:h-64
            smalldesktop:h-68
            desktop:h-72"
          >
          </div>
        </div>
        <div
          class="mobile:text-center
          tablet:text-center
          smalldesktop:text-right
          desktop:text-right"
        >
          <p
            class="text-theme-text text-subtitle1 hover:underline transition-all hover:scale-105 duration-600 cursor-pointer"
          >
            Say hello! ↗
          </p>
          <p class="text-theme-text text-subtitle1 font-playfair italic">
            Scroll to check my work
          </p>
        </div>
      </div>
    </section>

    <section class="">
      <!-- Projects -->
      <div
        class="mobile:flex mobile:flex-col mobile:gap-10 mobile:mt-10
        tablet:flex tablet:flex-col tablet:gap-10 tablet:mt-10
        smalldesktop:grid smalldesktop:grid-cols-2 smalldesktop:gap-10 smalldesktop:mt-10
        desktop:grid desktop:grid-cols-2 desktop:gap-10 desktop:mt-10"
      >
        <Project
          id="cowrite"
          title="The writer's companion"
          subtitle="Cowrite's placeholder"
          image={CowriteCover}
          icon={CowriteIcon}
          category="UX & Frontend"
        />
        <Project
          id="furhat"
          title="Teleoperator"
          subtitle="Furhat's placeholder"
          image={FurhatCover}
          icon={FurhatIcon}
          category="UX"
        />
        <Project
          id="dropdown"
          title="UI component"
          subtitle="Drop Down placeholder"
          image={DropDownCover}
          icon={DropDownIcon}
          category="Design component"
        />
        <!-- <Project
          title="CHIA"
          id="chia"
          subtitle="Cowrite's placeholder"
          image={CHIACover}
          icon={CHIAIcon}
          category="Graphic design"
        /> -->

        <!--         
        <Project
          title="Charlie"
          subtitle="Cowrite's placeholder"
          image={CowriteCover}
          icon={CowriteIcon}
        /> -->

        <!-- <Project
          title="Coupon app"
          subtitle="Coupon app's placeholder"
          image={CowriteCover}
          icon={CowriteIcon}
        />

        <Project
          title="Cool Dashboard"
          subtitle="Dashboard's placeholder"
          image={FurhatCover}
          icon={FurhatIcon}
        /> -->
      </div>

      <div class="divider my-16"></div>
      <!-- My design principles  -->
      <section
        class="relative flex flex-col items-center justify-center gap-10 pb-32
        tablet:flex tablet:flex-col tablet:items-center tablet:justify-center tablet:gap-10
        smalldesktop:flex smalldesktop:flex-col smalldesktop:items-center smalldesktop:justify-center smalldesktop:gap-10
        desktop:flex-col desktop:flex desktop:items-center desktop:justify-center desktop:gap-20"
      >
        <div class="absolute inset-0 w-full -z-10">
          <div class="arora-container">
            <div class="arora-item"></div>
            <div class="arora-item"></div>
            <div class="arora-item"></div>
          </div>
          <Meteors
            client:load
            number={15}
            minDelay={0.1}
            maxDelay={1.2}
            minDuration={2}
            maxDuration={10}
            angle={215}
          />
        </div>
        <h1
          class="text-theme-text font-playfair font-thin
          desktop:text-title2 desktop:text-left
          smalldesktop:text-title2 smalldesktop:text-left
          tablet:text-title3 tablet:text-center
          mobile:text-title3 mobile:text-center"
        >
          Design philosophy
        </h1>

        <div
          id="design-philosophy"
          class="grid grid-cols-1 gap-10
          tablet:grid-cols-2
          smalldesktop:grid-cols-3
          desktop:grid-cols-3"
        >
          <Microblog
            title="Design heuristics"
            subtitle="Simple yet efficient and doing what it's supposed to do."
            id="heuristics"
            image={DummyOne}
          />

          <Microblog
            title="What's an interface?"
            subtitle="Keeping it simple and playful. Focus on the things that bring delight to user."
            id="interface"
            image={DummyTwo}
          />

          <Microblog
            title="What is interaction?"
            subtitle="Keeping it simple and playful. Focus on the things that bring delight to user."
            id="interaction"
            image={DummyThree}
          />
        </div>
      </section>
      <div class="divider my-16"></div>

      <!-- Footer -->
      <Footer />
    </section>
  </main>
  <script>
    const cowriteBlog = document.getElementById("cowrite");
    const componentBlog = document.getElementById("dropdown");
    const furhatBlog = document.getElementById("furhat");
    const chiaBlog = document.getElementById("chia");
    const charlieBlog = document.getElementById("charlie");

    if (cowriteBlog) {
      cowriteBlog.addEventListener("click", () => {
        window.location.href = "/projects/cowrite/";
      });
      cowriteBlog.addEventListener("mousemove", (event) => {
        cowriteBlog.style.transform = `perspective(400px) rotateX(${event.layerX / 1000}deg) rotateY(${event.layerY / 1000}deg)`;
      });
      cowriteBlog.addEventListener("mouseleave", () => {
        cowriteBlog.style.transform = `perspective(400px) rotateX(0deg) rotateY(0deg)`;
      });
    }

    if (componentBlog) {
      componentBlog.addEventListener("click", () => {
        window.location.href = "/projects/dropdown/";
      });
      componentBlog.addEventListener("mousemove", (event) => {
        componentBlog.style.transform = `perspective(300px) rotateX(${event.layerX / 1000}deg) rotateY(${event.layerY / 1000}deg)`;
      });
      componentBlog.addEventListener("mouseleave", () => {
        componentBlog.style.transform = `perspective(300px) rotateX(0deg) rotateY(0deg)`;
      });
    }

    if (furhatBlog) {
      furhatBlog.addEventListener("click", () => {
        window.location.href = "/projects/furhat/";
      });
      furhatBlog.addEventListener("mousemove", (event) => {
        furhatBlog.style.transform = `perspective(300px) rotateX(${event.layerX / 1000}deg) rotateY(${event.layerY / 1000}deg)`;
      });
      furhatBlog.addEventListener("mouseleave", () => {
        furhatBlog.style.transform = `perspective(300px) rotateX(0deg) rotateY(0deg)`;
      });
    }

    if (chiaBlog) {
      chiaBlog.addEventListener("click", () => {
        window.location.href = "/projects/chia/";
      });
      chiaBlog.addEventListener("mousemove", (event) => {
        chiaBlog.style.transform = `perspective(300px) rotateX(${event.layerX / 1000}deg) rotateY(${event.layerY / 1000}deg)`;
      });
      chiaBlog.addEventListener("mouseleave", () => {
        chiaBlog.style.transform = `perspective(300px) rotateX(0deg) rotateY(0deg)`;
      });
    }

    if (charlieBlog) {
      charlieBlog.addEventListener("click", () => {
        window.location.href = "/projects/charlie/";
      });
      charlieBlog.addEventListener("mousemove", (event) => {
        charlieBlog.style.transform = `perspective(300px) rotateX(${event.layerX / 1000}deg) rotateY(${event.layerY / 1000}deg)`;
      });
      charlieBlog.addEventListener("mouseleave", () => {
        charlieBlog.style.transform = `perspective(300px) rotateX(0deg) rotateY(0deg)`;
      });
    }

    const designHeuristicsBlog = document.getElementById("heuristics");
    const whatsAnInterfaceBlog = document.getElementById("interface");
    const whatIsInteractionBlog = document.getElementById("interaction");

    if (designHeuristicsBlog) {
      designHeuristicsBlog.addEventListener("click", () => {
        window.location.href = "/microblogs/heuristics/";
      });
    }

    if (whatsAnInterfaceBlog) {
      whatsAnInterfaceBlog.addEventListener("click", () => {
        window.location.href = "/microblogs/interface/";
      });
    }

    if (whatIsInteractionBlog) {
      whatIsInteractionBlog.addEventListener("click", () => {
        window.location.href = "/microblogs/interaction/";
      });
    }
  </script>

  <style>
    #role-italic:before {
      display: block;
      position: absolute;
      content: "";
      top: 100%;
      width: 100%;
      left: 0;
      height: 3px;
      border-radius: 3px;
      background: var(--humana);
    }
  </style>
</Layout>
