          <p class="text-center">Oct 2021 - Mar 2023</p>
          <p class="text-center">UX consultant</p>
        </div>
        <div
        class="
          desktop:flex desktop:flex-col desktop:items-start
          smalldesktop:flex smalldesktop:flex-col smalldesktop:items-start
          tablet:flex tablet:flex-col tablet:justify-center tablet:items-center
