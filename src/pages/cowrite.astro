      />
    </section>

    <!-- Wireframes -->
    <section id="wireframes" class="flex flex-col desktop:my-2 smalldesktop:my-2 tablet:my-5 mobile:my-8">
      <BlogSection
        title="Wireframes"
        description=`A critical step of the design process is,
         visualizing the structure and layout of a website or app before moving into more detailed design work.
         Before moving into the prototyping process we designed wireframes and to better understand the flow of the app.`
        images={[Wireframe]}
      />
    </section>

    <!-- Prototype Section  -->
    <section id="prototype" class="flex flex-col desktop:my-2 smalldesktop:my-2 tablet:my-5 mobile:my-8">
      <BlogSection title="Prototype" />
    </section>

    <!-- Prototype Section One -->
    <section id="prototype-one" class="flex flex-col  desktop:my-2 smalldesktop:my-2 tablet:my-5 mobile:my-8">
      <BlogSection
        subtitle="Design System"
        description=`To start with the design system, we used the color, fonts and the logo used by 
        the brand cowrite to start with the development of the components. Our sources of inspiration for the
        web components were from some of the popular design systems like material design, human interface interface guideline and Carbon by IBM.`
        images={[Component]}
      />
    </section>

    <!-- Prototype Section Two -->
    <section id="prototype-two" class="flex flex-col desktop:my-2 smalldesktop:my-2 tablet:my-5 mobile:my-8">
      <BlogSection
        subtitle="Cover letter builder"
        description=`Our goal with the cover letter builder is to help job seekers quickly create professional, personalized cover letters.
                    It offers customizable templates, pre-written content, and real-time feedback on grammar and tone, ensuring a polished final product.
                    Users can easily download or share their letters, enhancing their chances with potential employers.`
        images={[PrototypeOne, PrototypeTwo]}
      />
    </section>

    <!-- Prototype Section Three -->
    <section id="prototype-three" class="flex flex-col desktop:my-2 smalldesktop:my-2 tablet:my-5 mobile:my-8">
      <BlogSection
        subtitle="Resume builder"
        description=`With the resume builder we tried to develop features that assist job seekers in efficiently creating professional, tailored resumes. 
        It provides customizable templates, pre-written content, and real-time feedback on formatting and content, ensuring a refined final document. 
        Users can easily download or share their resumes, thereby improving their prospects with potential employers.`
        images={[PrototypeThree, PrototypeFour]}
      />
    </section>

    <!-- Prototype Section four -->
    <section id="prototype-four" class="flex flex-col desktop:my-2 smalldesktop:my-2 tablet:my-5 mobile:my-8">
      <BlogSection
        subtitle="Mobile view"
        description=`The clients had also requested us to have the app ready in mobile view. Below are some of the screens from the project.`
        images={[PrototypeFive, PrototypeSix]}
      />
    </section>

    <div class="divider-light my-16"></div>

    <!-- More to explore -->
