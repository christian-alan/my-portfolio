import BlogSection from "../components/blog/BlogSection.astro";
---

<Layout title="Alan Christian">
  <main class="common-container" class="bg-light-green relative">
    <!-- Hero section -->
    <section
      class="
      desktop:pt-80 desktop:flex desktop:items-center desktop:flex-col
      smalldesktop:pt-80 smalldesktop:flex smalldesktop:items-center smalldesktop:flex-col
      tablet:pt-60 tablet:flex table:flex-col tablet:items-center 
      mobile:pt-60 mobile:flex mobile:flex-col mobile:items-center
      "
    >
      <!-- Header -->
      <div class="flex gap-4 flex-col blog-container">
        <h2
          class="text-dark desktop:text-left smalldesktop:text-left mobile:text-left tablet:text-left font-bold"
        >
          The ghost writer - Cowrite
        </h2>
        <h4 class="font-bold italic">
          <span class="humana-gradient text-dark/0 bg-clip-text desktop:text-left smalldesktop:text-left tablet:text-left mobile:text-left"
            >UX/UI design <br class="desktop:hidden tablet:hidden smalldesktop:hidden  mobile:block"> Frontend development</span>
        </h4>
        <p class="opacity-80 text-dark desktop:text-left mobile:text-left smalldesktop:text-left tablet:text-left">
          Cowrite’s writing platform, lets you craft resumes, job applications,
          job ads and LinkedIn summary in minutes. The process is simple and
          precise, boosting our customers' writing efficiency by an impressive
          45%.
        </p>
      </div>

      <div class="divider-light my-16"></div>
      <!-- Project meta data -->
      <div class=" 
      desktop:grid-cols-3 desktop:grid desktop:gap-5 desktop:text-dark desktop:blog-container desktop:items-baseline
      smalldesktop:grid-cols-3 smalldesktop:grid smalldesktop:gap-5 smalldesktop:text-dark smalldesktop:blog-container smalldesktop:items-baseline
      tablet:flex tablet:flex-col tablet:justify-center tablet:items-center tablet:gap-10 tablet:text-dark tablet:blog-container
      mobile:flex mobile:flex-col mobile:justify-center mobile:items-center mobile:gap-10 mobile:text-dark mobile:blog-container
    ">
        <div class="
          desktop:flex desktop:flex-col desktop:items-start
          smalldesktop:flex smalldesktop:flex-col smalldesktop:items-start
          tablet:flex tablet:flex-col tablet:justify-center tablet:items-center
          mobile:flex mobile:flex-col mobile:justify-center mobile:items-center
      ">
          <h4 class="font-bold mb-4 tablet:text-center mobile:text-center desktop:text-left smalldesktop:text-left">Roles & responsibilities</h4>
          <p class="">UX Design</p>
          <p class="">UI Design</p>
          <p class="">Frontend development</p>
        </div>
        <div
        class="
        desktop:flex desktop:flex-col desktop:items-center
        smalldesktop:flex smalldesktop:flex-col smalldesktop:items-center
        tablet:flex tablet:flex-col tablet:justify-center tablet:items-center
        mobile:flex mobile:flex-col mobile:justify-center mobile:items-center
      ">
          <h4 class="font-bold text-center mb-4 tablet:text-center mobile:text-center desktop:text-left smalldesktop:text-left">Project context</h4>
          <p class="text-center">Oct 2021 - Mar 2023</p>
          <p class="text-center">UX consultant</p>
        </div>
        <div
        class="
        desktop:flex desktop:flex-col desktop:items-end
        smalldesktop:flex smalldesktop:flex-col smalldesktop:items-end
        tablet:flex tablet:flex-col tablet:justify-center tablet:items-center
        mobile:flex mobile:flex-col mobile:justify-center mobile:items-center
      ">
          <h4 class="font-bold text-right mb-4 tablet:text-center mobile:text-center desktop:text-left smalldesktop:text-left">Tools used</h4>
          <p class="text-right">Figma</p>
          <p class="text-right">Vue.js</p>
          <p class="text-right">Javascript</p>
          <p class="text-right">Tailwind.css</p>
        </div>
      </div>

      <div class="divider-light my-16"></div>
      <!-- Hero image -->
      <Image
        src={Cover}
        class="cowrite-shadow rounded-xl mt-10"
        alt="Cowrite Hero"
      />
    </section>
    <div class="divider-light my-16"></div>

    <!-- Section jumps -->
    <div class="sticky top-20 -inset-20 z-10 flex">
      
      <ul
        class="flex absolute -left-52 text-sm flex-col gap-2  text-dark"
      >
        <li class="font-bold leading-10 tracking-widest">TABLE OF CONTENTS</li>
        <li><a href="#overview">Overview</a></li>
        <li><a href="#users">Users</a></li>
        <li><a href="#problems">Problems</a></li>
        <li><a href="#ia">Information architechture</a></li>
        <li><a href="#wireframes">Wireframes</a></li>
        <li><a href="#prototype">Prototype</a></li>
        <li style="margin-left:10px">
          <a href="#prototype-one">Design system</a>
        </li>
        <li style="margin-left:10px">
          <a href="#prototype-two">Cover Letter builder</a>
        </li>
        <li style="margin-left:10px">
          <a href="#prototype-three">Resume builder</a>
        </li>
        <li style="margin-left:10px"><a href="#prototype-four">Mobile view</a></li>
      </ul>
    </div>

    
    <!-- Overview section -->
    <section id="overview" class="flex flex-col desktop:my-2 smalldesktop:my-2 tablet:my-5 mobile:my-8">
      <BlogSection
        title="Overview"
        description=`This was a consulting project that I overtook between Oct 2021 & Mar 2023 for a swedish startup called 
        cowrite AB. During the project I took the responsibility of overseeing design & UX part of the project. On top of that
        I contributed to the code base by developing the frontend for the desktop view and the mobile view of the app.`
      />
    </section>

    <!-- Users section -->
    <section id="users" class="flex flex-col desktop:my-2 smalldesktop:my-2 tablet:my-5 mobile:my-8">
      <BlogSection
        title="Users"
        subtitle="Personas"
        description=`Through meetings and discussions with the founders, we identified the
          4 types of job seeker who cowrite could target as a smart job
          application building tool. They are, Emily - a 22 years old recent
          graduate, James - a 36 years old mid career professional, Linda - a 40
          years old career changer and Sarah - a 32 years old the returnee to
          the workforce.`
        images={[Persona]}
      />
    </section>

    <!-- Problems -->
    <section id="problems" class="flex flex-col desktop:my-2 smalldesktop:my-2 tablet:my-5 mobile:my-8">
      <BlogSection
        title="Problems"
        description=` On analysing the users discussed above and understanding their
          challenges, we identified four key challenges that the product could
          address.`
        images={[Problems]}
      />
    </section>

    <div class="divider-light mb-16"></div>

    <!-- IA -->
    <section id="ia" class="flex flex-col desktop:my-2 smalldesktop:my-2 tablet:my-5 mobile:my-8">
      <BlogSection
        title="Information Architecture"
        description=` To optimize internal operations, we will build scalable design
			components, which will work across FavePay, Deals & eCards.`
