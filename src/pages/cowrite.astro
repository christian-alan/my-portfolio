      class="
      desktop:pt-80 desktop:flex desktop:items-center  desktop:flex-row
      smalldesktop:pt-80 smalldesktop:flex smalldesktop:items-center smalldesktop:flex-row
      tablet:pt-60 tablet:flex table:flex-col tablet:items-center 
      mobile:pt-60 mobile:flex mobile:flex-col mobile:items-center
      "
    >
      <!-- Header -->
      <div class="flex gap-4 flex-col blog-container">
        <h2
          class="text-dark desktop:text-left smalldesktop:text-left mobile:text-center tablet:text-center font-bold"
        >
          The ghost writer - Cowrite
        </h2>
        <h4 class="font-bold italic">
          <span class="humana-gradient text-dark/0 bg-clip-text"
            >UX/UI design Frontend development</span>
        </h4>
        <p class="opacity-80 text-dark">
          Cowrite’s writing platform, lets you craft resumes, job applications,
          job ads and LinkedIn summary in minutes. The process is simple and
          precise, boosting our customers' writing efficiency by an impressive
          45%.
        </p>
      </div>

      <div class="divider-light my-16"></div>
      <!-- Project meta data -->
