        desktop:grid-cols-3 desktop:grid desktop:gap-5 desktop:text-dark desktop:blog-container
        smalldesktop:grid-cols-3 smalldesktop:grid smalldesktop:gap-5 smalldesktop:text-dark smalldesktop:blog-container
