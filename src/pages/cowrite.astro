---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import PrototypeOne from "../assets/cowrite/POne.jpg";
import Cover from "../assets/cowrite/Cover.jpg";
import Wireframe from "../assets/cowrite/Wireframes.jpg";
import PrototypeTwo from "../assets/cowrite/PTwo.jpg";
import PrototypeThree from "../assets/cowrite/PThree.jpg";
import PrototypeFour from "../assets/cowrite/PFour.jpg";
import PrototypeFive from "../assets/cowrite/PFive.jpg"
import PrototypeSix from "../assets/cowrite/PSix.jpg"
import Persona from "../assets/cowrite/Persona.jpg";
import IA from "../assets/cowrite/IA.jpg";
import Problems from "../assets/cowrite/Problem.jpg";
import Footer from "../components/Footer.astro";
