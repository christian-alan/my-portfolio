---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ImageOverlay from "../../components/ImageOverlay.astro"; // Import ImageOverlay component

// This generates all possible paths for the dynamic route
export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

export const prerender = true
const { project } = Astro.props;
const { Content, headings } = await project.render();

// Get all h2 headings for the table of contents
const tableOfContents = headings.filter((heading) => heading.depth === 2);
---

<Layout title={project.data.title}>
  <main class="common-container text-theme-text relative">
    <section
      class="flex flex-col gap-10
        desktop:pt-40 desktop:pb-44
        smalldesktop:py-60
        tablet:pt-40 tablet:pb-24
        mobile:pt-40 mobile:pb-24"
    >
      <Breadcrumbs previousPath="Projects" currentPath={project.data.title} />
      <Image
        src={project.data.cover.src}
        alt={project.data.cover.alt}
        width={2000}
        height={1000}
        fit="cover"
      />
      <ImageOverlay />

      <div
        class="desktop:grid desktop:grid-cols-6 desktop:gap-20
         smalldesktop:grid smalldesktop:grid-cols-6 smalldesktop:gap-20
         tablet:flex tablet:flex-col tablet:gap-10
        mobile:flex mobile:flex-col mobile:gap-10"
      >
        <article
          class="desktop:col-span-4
                 smalldesktop:col-span-4
                 tablet:w-full
                 mobile:w-full"
        >
          <div class="flex flex-col gap-4">
            <p class="text-body1 font-DM font-bold">{project.data.category}</p>
            <h1 class="text-title2 font-playfair">{project.data.title}</h1>
            <p class="text-body1 font-DM">
              {project.data.author} / {project.data.date}
            </p>
          </div>
          <div class="divider my-10"></div>
          <div id="body" class="max-w-none">
            <Content />
          </div>
        </article>
        <div
          class="desktop:col-span-2
          smalldesktop:col-span-2
          tablet:w-full
          mobile:w-full
          relative"
        >
          <div
            class="sticky top-28 mobile:hidden tablet:hidden desktop:block smalldesktop:block"
          >
            <TableOfContents items={tableOfContents} />
          </div>
        </div>
      </div>
    </section>
    <div class="divider my-16"></div>
    <Footer />
  </main>
</Layout>

<style>
  :global(#body p) {
    font-family: "DM Sans", serif;
    font-size: 18px;
    line-height: 26px;
    margin: 1rem 0;
  }

  :global(#body h2) {
    font-family: "DM Sans", serif;
    font-size: 36px;
    line-height: 48px;
    margin: 2rem 0 1rem;
    font-weight: 600;
  }

  :global(#body h3) {
    font-family: "DM Sans", serif;
    font-size: 18px;
    line-height: 32px;
    margin: 1.5rem 0 0.75rem;
    font-weight: 600;
  }

  :global(#body li) {
    font-family: "DM Sans", serif;
    font-size: 18px;
    line-height: 28px;
    margin-bottom: 0.75rem;
  }
  :global(pre) {
    padding: 1rem;
  }
</style>
