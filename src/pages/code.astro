---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import Nav from "../components/Nav.astro";
---

<Layout title="Alan Christian">
  <main class="common-container">
    <section
      class="desktop:pt-80 desktop:pb-60 relative smalldesktop:py-44 tablet:py-32 mobile:py-16 table:flex-col tablet:items-center mobile:flex-col mobile:items-center smalldesktop:items-center desktop:items-center smalldesktop:flex-row desktop:flex-row"
    >
      <div class="desktop:w-full tablet:w-full mobile:w-full">
        <h1
          class="text-dark desktop:text-left smalldesktop:text-left mobile:text-center tablet:text-center"
        >
          Keeping it simple <br /> is my <span
            class="humana-gradient text-dark/0 bg-clip-text"
          >
            mantra.</span
          >
        </h1>
        <p
          class="text-dark text-2xl opacity-70 mt-10 desktop:text-left smalldesktop:text-left mobile:text-center tablet:text-center"
        >
          What do I mean by that?
        </p>

        <p
          class="text-dark text-2xl opacity-70 mt-10 desktop:text-left smalldesktop:text-left mobile:text-center tablet:text-center"
        >
          Less code is clean code...
        </p>
      </div>
      <div
        class="boe-gif desktop:w-1/4 desktop:absolute desktop:top-64 desktop:right-0 smalldesktop:absolute smalldesktop:right-0 smalldesktop:top-32 smalldesktop:w-1/4 desktop:h-96 smalldesktop:h-96 mobile:h-48 mobile:w-full tablet:w-full tablet:h-72"
      >
      </div>
    </section>
  </main>
</Layout>
