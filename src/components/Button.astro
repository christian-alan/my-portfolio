---
interface Props {
  label: string;
  onClick: () => void;
  className?: string;
}

const { label, onClick, className } = Astro.props;
---

<button
  id="download-cv"
  class={`bg-teal hover:scale-105 transition-all duration-300 text-light w-60 p-4 dark:bg-gray  ${className}`}
>
  {label}
</button>


