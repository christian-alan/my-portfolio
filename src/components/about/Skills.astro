---
import { Image } from "astro:assets";
const { image, title, classes } = Astro.props;
---

<div class={`skills ${classes} text-theme-text`}>
  {image && <Image src={image} alt={title} width={40} height={40} />}
  <p
    class="desktop:text-body1 smalldesktop:text-body2 tablet:text-body2 mobile:text-body2"
  >
    {title}
  </p>
</div>
