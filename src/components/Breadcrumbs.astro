---
const { previousPath, currentPath } = Astro.props;
---

<nav aria-label="breadcrumb">
  <ol class="list-none p-0 inline-flex text-theme-text">
    <li class="flex items-center">
      <a href="/" class="text-body1 hover:underline">{previousPath}</a>

      <svg
        class="w-3 h-3 mx-3 fill-theme-text"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 320 512"
      >
        <path
          d="M285.476 272.971L91.314 467.314c-9.373 9.373-24.569 9.373-33.941 0l-22.627-22.627c-9.373-9.373-9.373-24.569 0-33.941L196.686 256 34.746 94.255c-9.373-9.373-9.373-24.569 0-33.941l22.627-22.627c9.373-9.373 24.569-9.373 33.941 0L285.476 239.03c9.373 9.373 9.373 24.569 0 33.941z"
        ></path>
      </svg>
    </li>
    <li class="flex items-center">
      <span class="text-body1 font-bold">{currentPath}</span>
    </li>
  </ol>
</nav>

<style>
  .breadcrumb-link {
    font-family: "DM Sans", sans-serif;
    font-size: 1rem;
    line-height: 1.5rem;
    color: #2563eb; /* text-blue-600 */
    font-weight: bold;
    text-decoration: none;
    transition: text-decoration 0.2s;

    &:hover {
      text-decoration: underline;
    }
  }

  nav {
    padding: 0;
    margin: 0;
  }
</style>
