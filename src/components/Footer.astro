---
import { Image } from "astro:assets";
import LogoImg from "../assets/Logo.svg";

const resumeLink = 'https://drive.google.com/file/d/14bNyYYbjFtiCrKHA45TV7wMTLmlEBkbb/view?usp=sharing';
const linkedInLink = 'https://www.linkedin.com/in/alan-christian-955327159/'
---

<footer class="flex flex-col ">
  <!-- header -->
  <div class="desktop:flex desktop:justify-between desktop:flex-row
              smalldesktop:flex smalldesktop:justify-between smalldesktop:flex-row
              tablet:flex tablet:flex-row tablet:justify-between tablet:gap-10 
              mobile:flex mobile:flex-col mobile:justify-between mobile:gap-10
  ">
    <Image src={LogoImg} alt="Logo SVG" />
    <div>
      <h2
        class="desktop:text-4xl smalldesktop:text-4xl tablet:text-3xl mobile:text-3xl"
      >
      <span class="humana-gradient font-semibold text-dark/0 bg-clip-text ">
        Let’s connect <br />
        Drop me a line
      </span>
        😄
      </h2>
    
      <!-- Links -->
      <ul class="grid grid-cols-2 mt-10 gap-5 opacity-80 text-dark">
        <li><a class="text-base font-medium hover:font-bold ease-out" href="/">Design</a></li>
        <li><a class="text-base font-medium hover:font-bold ease-out" href={linkedInLink}>LinkedIn</a></li>
        <!-- <li><a class="text-base font-base" href="/code/">Code</a></li> -->
        <li><a class="text-base font-medium hover:font-bold ease-out" href="/about/">About me</a></li>
        <li><a class="text-base font-medium hover:font-bold ease-out" href={resumeLink}>Resume</a></li>
      </ul>
    </div>
  </div>

  <div class="mt-16 mb-8 divider-light"></div>
  <!-- Stamps -->
  <div class="w-full flex justify-between mb-8">
    <p class="text-sm font-light">© 2024 Alan Christian</p>
    <p class="text-sm font-light">Crafted with my own hands🫶</p>
  </div>
</footer>
