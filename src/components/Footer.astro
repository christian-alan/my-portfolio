---
import { Image } from "astro:assets";
import LogoImg from "../assets/Logo.svg";
---

<footer class="flex flex-col">
  <!-- header -->
  <div class="flex justify-between">
    <Image src={LogoImg} alt="Logo SVG" />
    <div>
      <h2
        class="humana-gradient font-semibold text-dark/0 bg-clip-text text-3.5xl"
      >
        Let’s connect <br />
        Drop me a line ↗
      </h2>
      <!-- Links -->
      <ul class="grid grid-cols-2 mt-10 gap-5 opacity-80 text-dark">
        <li><a class="text-base font-base" href="/">Design</a></li>
        <li><a class="text-base font-base" href="/code/">LinkedIn</a></li>
        <li><a class="text-base font-base" href="/code/">Code</a></li>
        <li><a class="text-base font-base" href="/code/">Resume</a></li>
        <li><a class="text-base font-base" href="/about/">About me</a></li>
      </ul>
    </div>
  </div>

  <div class="mt-16 mb-8 divider-light"></div>
  <!-- Stamps -->
  <div class="w-full flex justify-between mb-8">
    <p class="text-sm font-light">© 2024 Alan Christian</p>
    <p class="text-sm font-light">Crafted with my own hands🫶</p>
  </div>
</footer>
