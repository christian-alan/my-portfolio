---
import { Image } from "astro:assets";
import LogoImg from "../assets/Logo.svg";
import MoonIcon from "../assets/icons/Moon.svg";
---
<nav class="desktop:flex desktop:justify-center desktop:font-raleway desktop:py-6
smalldesktop:flex smalldesktop:justify-center smalldesktop:font-raleway smalldesktop:py-6
tablet:flex tablet:justify-center tablet:font-raleway tablet:py-6
mobile:flex mobile:w-full mobile:justify-center mobile:font-raleway mobile:py-6
">
  <ul class="flex desktop:gap-10 smalldesktop:gap-10 tablet:gap-10 mobile:gap-8 nav-bar">
    <a href="/">
      <Image
        src={LogoImg}
        alt="Logo of the website"
        data-astro-cid-dmqpwcec="true"
      />
    </a>
    <li><a id="home-link" class="nav-link text-lg" href="/">Design</a></li>
    <!-- <li><a id="code-link" class="nav-link text-base" href="/code/">Code</a></li> -->
    <li>
      <a id="about-link" class="nav-link text-lg" href="/about/">About me</a>
    </li>
    <!-- <button id="theme-btn" class="rounded-full p-3 bg-dark">
      <Image src={MoonIcon} alt="Moon Logo" data-astro-cid-dmqpwcec="true" />
    </button> -->
  </ul>
</nav>

