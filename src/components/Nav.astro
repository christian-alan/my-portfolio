---
import { Image } from "astro:assets";
import LogoImg from "@/assets/logos/Logo.svg";
import ThemeButton from "@/components/ThemeButton.astro";
---

<nav class="nav-bar">
  <a href="/">
    <Image
      src={LogoImg}
      alt="Logo of the website"
      data-astro-cid-dmqpwcec="true"
      style="-webkit-user-drag: none;"
    />
  </a>

  <ul
    class="flex desktop:gap-10 smalldesktop:gap-10 tablet:gap-10 mobile:gap-8"
  >
    <li>
      <a id="home-link" class="nav-link text-body2 text-theme-text" href="/"
        >Design</a
      >
    </li>
    <li>
      <a
        id="publications-link"
        class="nav-link text-body2 text-theme-text"
        href="/publications/">Research</a
      >
    </li>
    <li>
      <a
        id="about-link"
        class="nav-link text-body2 text-theme-text"
        href="/about/">About</a
      >
    </li>
  </ul>

  <ThemeButton id="theme-btn" />
</nav>

<script>
  const homeLink = document.getElementById("home-link");
  const aboutLink = document.getElementById("about-link");
  const publicationsLink = document.getElementById("publications-link");

  
  // Buttons
  const themeBtn = document.getElementById("theme-btn");


  // Theme toggle
  const themeToggle = () => {
    const currentTheme = document.documentElement.getAttribute("data-theme");
    const newTheme = currentTheme === "dark" ? "light" : "dark";
    document.documentElement.setAttribute("data-theme", newTheme);
    localStorage.setItem("theme", newTheme); // Store theme in local storage
  };


  // Event listener
  if (themeBtn) {
    themeBtn.addEventListener("click", themeToggle);
  }


  // Active links
  const setActiveLink = (link: HTMLElement | null, isActive: boolean) => {
    if (link) {
      link.style.fontWeight = isActive ? "bold" : "normal";
      link.style.textDecoration = isActive ? "underline" : "none";
    }
  };

  const path = window.location.pathname;

  // Handle home and project routes
  if (path === "/" || path.startsWith("/projects/")) {
    setActiveLink(homeLink, true);
  }

  // Handle about route
  if (path === "/about/") {
    setActiveLink(aboutLink, true);
  }

  // Handle publications route
  if (path === "/publications/") {
    setActiveLink(publicationsLink, true);
  }
</script>

<style>
  .nav-link {
    -webkit-transition: color 0.3s;
    transition: color 0.3s;
  }
  .dark .nav-link {
    color: #fbf8f4; /* Light color for dark mode */
    -webkit-tap-highlight-color: transparent;
  }
  /* Prevent text selection on navigation */
  nav {
    -webkit-user-select: none;
    user-select: none;
  }
</style>
