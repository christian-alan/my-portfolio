---
import "@/main.css";
import "@/arora.css";
import Nav from "@/components/Nav.astro";
import { Particles } from "@/components/magicui/particles";
import { Meteors } from "@/components/magicui/meteors";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Astro description" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body
    id="portfolio-body"
    class="bg-bkg relative
    desktop:w-screen desktop:h-screen desktop:relative desktop:overflow-x-clip
    smalldesktop:w-screen smalldesktop:h-screen smalldesktop:relative smalldesktop:overflow-x-clip
    tablet:w-screen tablet:h-screen tablet:relative tablet:overflow-x-clip
    mobile:w-screen mobile:h-screen mobile:relative mobile:overflow-x-clip"
  >
    <div class="arora-container">
      <div class="arora-item"></div>
      <div class="arora-item"></div>
      <div class="arora-item"></div>
      <div class="arora-item"></div>
      <div class="arora-item"></div>
      <div class="arora-item"></div>
      <div class="arora-item"></div>
      <div class="arora-item"></div>
      <div class="arora-item"></div>
    </div>
    <Particles
      className="absolute inset-0"
      client:load
      quantity={300}
      ease={100}
      color={"#FBF8F4"}
      refresh
    />

    <div
      class="desktop:fixed desktop:w-full desktop:z-10
      smalldesktop:fixed smalldesktop:w-full smalldesktop:z-10
      tablet:fixed tablet:w-full tablet:z-10
      mobile:fixed mobile:w-full mobile:z-10"
    >
      <Nav />
    </div>
    <slot />
  </body>
</html>

<script>
  const systemTheme = window.matchMedia("(prefers-color-scheme: dark)").matches
    ? "dark"
    : "light";
  const userTheme = localStorage.getItem("theme");
  const setTheme = () => {
    if (userTheme) {
      document.documentElement.setAttribute("data-theme", userTheme);
    } else {
      document.documentElement.setAttribute("data-theme", systemTheme);
    }
  };

  setTheme();
</script>
