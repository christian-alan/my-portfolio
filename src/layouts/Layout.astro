---
import "./../main.css";
import Nav from "../components/Nav.astro";
import { Image } from "astro:assets";
import EllipseOne from "../assets/background/Ellipse_one.png";
import EllipseTwo from "../assets/background/Ellipse_two.png";
import EllipseThree from "../assets/background/Ellipse_three.png";
import EllipseFour from "../assets/background/Ellipse_four.png";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Astro description" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body
    id="portfolio-body"
    class="
      desktop:noise-bg desktop:w-screen desktop:h-screen desktop:relative desktop:overflow-x-clip
      smalldesktop:noise-bg smalldesktop:w-screen smalldesktop:h-screen smalldesktop:relative smalldesktop:overflow-x-clip
      tablet:noise-bg tablet:w-screen tablet:h-screen tablet:relative tablet:overflow-x-clip
      mobile:noise-bg mobile:w-screen mobile:h-screen mobile:relative mobile:overflow-x-clip
      "
    >
    <Image class="absolute -left-44" src={EllipseOne} alt="Decore" />
    <Image
      class="absolute -left-44"
      style={{ bottom: "-100rem" }}
      src={EllipseTwo}
      alt="Decore"
      id="layer-blur-one"
    />
    <Image class="absolute -right-44" src={EllipseThree} alt="Decore" />
    <Image
      class="absolute -right-64"
      style={{ bottom: "-100rem" }}
      src={EllipseFour}
      alt="Decore"
      id="layer-blur-two"
    />
    
    <div class="
      desktop:px-auto desktop:fixed desktop:w-full desktop:z-10
      smalldesktop:px-auto smalldesktop:fixed smalldesktop:w-full smalldesktop:z-10
      tablet:px-auto tablet:fixed tablet:w-full tablet:z-10
      mobile:px-0 mobile:fixed mobile:w-full mobile:z-10
    ">
      <Nav />
    </div>
    <slot />
  </body>
</html>

<script>
  const body = document.getElementById("portfolio-body");
  const blursOne = document.getElementById("layer-blur-one");
  const blursTwo = document.getElementById("layer-blur-two");


  if (window.location.pathname === "/") {
    body.style.backgroundColor = "#FDFAF6";
  } else if (window.location.pathname === "/cowrite/") {
    body.style.backgroundColor = "#F4FBF4";
  } else if (window.location.pathname === "/furhat/") {
    body.style.backgroundColor = "#F5F8FF";
  }


  if(window.location.pathname === "/about/"){
    blursOne.style.display = "none"
    blursTwo.style.display = "none"
  }


</script>
